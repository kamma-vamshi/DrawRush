rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DrawRush uses backend-mediated architecture where all database mutations
    // occur via the Fastify server using the Firebase Admin SDK.
    // Direct mobile client read/write to Firestore collections is strictly disabled
    // to prevent unauthorized tampering with user scores, profiles, and friendships.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
