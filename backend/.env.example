PORT=3001
NODE_ENV=development

# Set to true to skip Firebase token verification (DEV ONLY — never use in production)
DEV_AUTH=true

# Redis (distributed state for production / multi-instance)
USE_REDIS=false
REDIS_URL=redis://localhost:6379

# Firebase Admin SDK (required when DEV_AUTH=false)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Tuning
MAX_CANVAS_HISTORY=500
DISCONNECT_GRACE_MS=15000
ARTIST_DISCONNECT_GRACE_MS=5000
HOST_MIGRATE_GRACE_MS=8000
COUNTDOWN_MS=3000
WORD_SELECTION_TIMEOUT_MS=15000
ROUND_RESULT_MS=5000
CHAT_RATE_LIMIT_TOKENS=10
CHAT_RATE_LIMIT_WINDOW_MS=5000
DRAW_RATE_LIMIT_TOKENS=60
DRAW_RATE_LIMIT_WINDOW_MS=1000
MAX_PAYLOAD_BYTES=65536
